{
  "name": "x402-firewall",
  "version": "0.1.3",
  "description": "Smart Wallet Firewall & Auto-Pay Wrapper for AI Agents on Base L2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "x402-firewall": "./dist/cli.js",
    "x402firewall": "./dist/cli.js",
    "x402firewall-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "require": "./dist/config/index.js",
      "default": "./dist/config/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./x402": {
      "types": "./dist/x402/index.d.ts",
      "import": "./dist/x402/index.js",
      "require": "./dist/x402/index.js",
      "default": "./dist/x402/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "require": "./dist/mcp/index.js",
      "default": "./dist/mcp/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "LOG_LEVEL=error vitest run",
    "test:watch": "vitest",
    "start": "tsx src/cli.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x402-firewall/firewall.git"
  },
  "homepage": "https://github.com/x402-firewall/firewall#readme",
  "bugs": {
    "url": "https://github.com/x402-firewall/firewall/issues"
  },
  "keywords": [
    "x402",
    "ai-agent",
    "smart-wallet",
    "firewall",
    "mcp",
    "base",
    "usdc",
    "eip-3009"
  ],
  "author": "x402Firewall Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  }
}
